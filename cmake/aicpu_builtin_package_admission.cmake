macro(check_aicpu_builtin_pkg_admission _adm_op _adm_var)
  set(${_adm_var} OFF)
  if(NOT ENABLE_BUILT_IN)
    set(${_adm_var} ON)
  elseif(AICPU_BUILTIN_PACKAGE_FORCE_ALL)
    set(${_adm_var} ON)
  else()
    foreach(_aicpu_manifest_entry IN LISTS AICPU_BUILTIN_PACKAGE_MANIFEST)
      if(_aicpu_manifest_entry STREQUAL "${_adm_op}=ON")
        set(${_adm_var} ON)
        break()
      endif()
    endforeach()
  endif()
  unset(_aicpu_manifest_entry)
endmacro()
